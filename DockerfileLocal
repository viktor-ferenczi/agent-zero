# Use the pre-built base image for A0
# FROM agent-zero-base:local
FROM agent0ai/agent-zero-base:latest

SHELL ["/bin/bash", "-c"]

# Set BRANCH to "local" if not provided
ARG BRANCH=local
ENV BRANCH=$BRANCH

# 1. Copy install/runtime scripts (rarely change)
COPY ./docker/run/fs/ /

# 2. Pre-installation: apt update, SSH setup (no source code needed)
RUN bash /ins/pre_install.sh $BRANCH

# 3. Copy ONLY dependency manifests (change rarely)
COPY requirements.txt requirements2.txt /tmp/deps/

# 4. Install Python dependencies (CACHED unless requirements change)
RUN . /ins/setup_venv.sh $BRANCH && \
    uv pip install -r /tmp/deps/requirements.txt && \
    uv pip install -r /tmp/deps/requirements2.txt && \
    rm -rf /tmp/deps

# 5. Install Playwright + Chromium (CACHED, rarely changes)
RUN bash /ins/install_playwright.sh $BRANCH

# 6. Copy full source code LAST (changes frequently during dev)
COPY ./ /git/agent-zero

# 7. Preload models (needs full source tree)
RUN . /ins/setup_venv.sh $BRANCH && \
    python /git/agent-zero/preload.py --dockerized=true

# 8. Cleanup
RUN bash /ins/post_install.sh $BRANCH
RUN . /ins/setup_venv.sh $BRANCH && pip cache purge && uv cache prune

# Expose ports
EXPOSE 22 80 9000-9009

RUN chmod +x /exe/initialize.sh /exe/run_A0.sh /exe/run_searxng.sh /exe/run_tunnel_api.sh

# initialize runtime and switch to supervisord
CMD ["/exe/initialize.sh", "$BRANCH"]
